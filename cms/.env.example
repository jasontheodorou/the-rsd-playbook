# --- CMS environment ---
# Copy to .env and fill in the values. The CMS refuses to boot if any of the
# required vars are missing (fail-closed).

# Required: Postgres connection string. Vercel Postgres and Neon both work.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Required: any long random string. Rotate carefully — invalidates sessions.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Required for publish-request emails. Get from resend.com.
RESEND_API_KEY=re_xxx
RESEND_FROM=no-reply@transformuk.com

# Public URLs used for Live Preview and email review links.
SITE_URL=https://rsd.transformuk.com
PREVIEW_URL=https://rsd-manual-preview.vercel.app
CMS_URL=https://rsd-manual-cms.vercel.app
