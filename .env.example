# --- Site (Vite SPA) environment ---
# Copy to .env and fill in.

# Access gate — outer password wrapper. Fail-closed: if this is empty in
# production, the gate refuses to open.
VITE_GATE_PASSWORD=change-me

# CMS URL — when set, the SPA will fetch pathway content from this URL
# instead of the hardcoded modules.ts. Leave unset for local-only V1.
# Example: https://rsd-manual-cms.vercel.app
VITE_CMS_URL=

# --- Vercel deployment notes ---
# Two related but separate concerns:
#
# 1. The SPA itself needs VITE_GATE_PASSWORD and (once V2 is live) VITE_CMS_URL.
# 2. The CMS (cms/ directory) has its own env — see cms/.env.example.
#
# If you deploy both from the same Vercel project (via vercel.json rewrites),
# both sets of env vars go into that project's dashboard.
